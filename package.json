{
  "name": "se-karuta-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "seed": "node scripts/create-tournament.mjs data/questions/demo.json",
    "questions:check": "node --import tsx scripts/validate-questions.ts",
    "test": "vitest run",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.jsonc index.html",
    "check": "npm run typecheck && npm run questions:check && npm test && npm run test:worker && npm run test:integration && npm run build"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260918.0-alpha",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0",
    "ws": "^8.21.3"
  }
}
